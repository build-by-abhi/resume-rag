# ==========================================================================
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env     (macOS/Linux)
#   copy .env.example .env   (Windows PowerShell)
# NEVER commit the real .env to git.
# ==========================================================================

# ---------- App ----------
APP_NAME="Resume RAG API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call this API (the React app).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database (Postgres + pgvector) ----------
# Matches the service name in docker-compose.yml. If you run Postgres
# natively instead, change the host/user/password to match your install.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resume_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL. Assembled from the parts above by app/core/config.py, so you
# normally do NOT need to edit this line.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resume_rag

# ---------- Embeddings ----------
# Which embedding backend to use:
#   "sentence-transformers" | "openai" | "huggingface" | "hashing"
#   sentence-transformers  -> RECOMMENDED. Free, local, no data leaves the
#                             machine, genuinely semantic. Downloads ~90 MB on
#                             first run, then runs on CPU (~450 ms per query).
#   huggingface            -> hosted, uses HUGGINGFACE_API_KEY. No local download,
#                             but every call is a network round trip and the free
#                             tier is rate limited - slow for bulk ingestion.
#   openai                 -> best quality, needs OPENAI_API_KEY, costs money
#   hashing                -> deterministic, offline, zero downloads. NOT
#                             semantic (lexical only). For CI and unit tests.
EMBEDDING_PROVIDER=sentence-transformers
# MUST match the model's width:
#   all-MiniLM-L6-v2 -> 384   |   all-mpnet-base-v2 -> 768   |   text-embedding-3-small -> 1536
#   BAAI/bge-small-en-v1.5 -> 384   |   BAAI/bge-large-en-v1.5 -> 1024
# Changing this value requires re-creating the vector columns:
#   python -m scripts.seed --drop
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64

# ---------- LLM (used to write the natural-language answer) ----------
# "openai" | "huggingface" | "anthropic" | "gemini" | "none"
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# OpenAI
OPENAI_API_KEY=
# HuggingFace Inference API. One key covers BOTH the LLM and (optionally)
# EMBEDDING_PROVIDER=huggingface.
#
# Qwen3-8B is NOT gated, so a plain read token is enough - no licence click.
# Verify before restarting:  python scripts/check_llm.py
#
# Model size guidance for this app: 8B is the sweet spot. Below that the model
# invents citation markers and emits unparseable JSON; 14B+ costs more credits.
LLM_PROVIDER=huggingface
LLM_MODEL=Qwen/Qwen3-8B
HUGGINGFACE_API_KEY=

# Forwarded verbatim to the provider's chat endpoint as `extra_body`.
# Only needed for hybrid reasoning models. `Qwen/Qwen3-*` is one, so this is
# set automatically to {"enable_thinking": false} - see Settings.llm_extra_body_merged.
# Set it explicitly to override, e.g. to turn reasoning ON for JD matching.
# LLM_EXTRA_BODY={"enable_thinking": false}
# Anthropic
ANTHROPIC_API_KEY=
# Google
GEMINI_API_KEY=

# ---------- Ingestion ----------
MAX_UPLOAD_MB=10
# Chunking: tokens are approximated (1 token ~= 4 chars) to avoid a tokenizer dep
CHUNK_SIZE=350
CHUNK_OVERLAP=60

# ---------- Search / retrieval ----------
TOP_K=10                      # final number of candidates returned to the UI
CANDIDATE_MULTIPLIER=4        # fetch top_k * multiplier, then rerank
# Cross-encoder reranking. Big quality win, costs ~300-500 ms per query on CPU
# and downloads a second small model (~90 MB) on first use. Turn it off if you
# only need the RRF fusion.
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60                      # Reciprocal Rank Fusion smoothing constant